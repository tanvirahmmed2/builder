-- ============================================================================
-- WEBSITE TABLES SCHEMA (Business, Store, POS & Management Console)
-- All tables are partitioned per website using website_id.
-- Strictly prefixed with website_ (Exactly 339 tables as defined in TABLES_LIST.md).
-- Multi-Tenant Golden Rule: Every table has website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE.
-- ============================================================================

CREATE OR REPLACE FUNCTION trigger_set_timestamp()
RETURNS TRIGGER AS $$
BEGIN
  NEW.updated_at = NOW();
  RETURN NEW;
END;
$$ LANGUAGE plpgsql;


-- ============================================================================
-- MODULE 1. Universal Core Tenant & System Configuration (1-30)
-- ============================================================================

-- Table 1: website_settings
CREATE TABLE IF NOT EXISTS website_settings (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    site_name VARCHAR(255) NOT NULL DEFAULT 'My Website',
    site_title VARCHAR(255),
    tagline VARCHAR(255),
    description TEXT,
    logo_url TEXT,
    favicon_url TEXT,
    og_image_url TEXT,
    contact_email VARCHAR(255),
    contact_phone VARCHAR(50),
    whatsapp_number VARCHAR(50),
    address TEXT,
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    currency_symbol VARCHAR(10) NOT NULL DEFAULT '$',
    timezone VARCHAR(50) NOT NULL DEFAULT 'UTC',
    date_format VARCHAR(20) NOT NULL DEFAULT 'YYYY-MM-DD',
    time_format VARCHAR(20) NOT NULL DEFAULT 'HH:mm',
    meta_pixel_id VARCHAR(100),
    google_analytics_id VARCHAR(100),
    custom_css TEXT,
    custom_js TEXT,
    settings JSONB NOT NULL DEFAULT '{}'::jsonb,
    CONSTRAINT uq_website_settings_web UNIQUE (website_id),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_settings_web ON website_settings (website_id);

DROP TRIGGER IF EXISTS trg_website_settings_updated_at ON website_settings;
CREATE TRIGGER trg_website_settings_updated_at
BEFORE UPDATE ON website_settings
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- Table 2: website_themes
CREATE TABLE IF NOT EXISTS website_themes (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    theme_name VARCHAR(100) NOT NULL DEFAULT 'Modern Default',
    theme_slug VARCHAR(100) NOT NULL DEFAULT 'modern-default',
    color_primary VARCHAR(50) NOT NULL DEFAULT '#3b82f6',
    color_secondary VARCHAR(50) NOT NULL DEFAULT '#64748b',
    color_accent VARCHAR(50) NOT NULL DEFAULT '#06b6d4',
    color_background VARCHAR(50) NOT NULL DEFAULT '#090d16',
    color_surface VARCHAR(50) NOT NULL DEFAULT '#111827',
    color_text VARCHAR(50) NOT NULL DEFAULT '#f9fafb',
    font_heading VARCHAR(100) NOT NULL DEFAULT 'Inter',
    font_body VARCHAR(100) NOT NULL DEFAULT 'Inter',
    border_radius VARCHAR(20) NOT NULL DEFAULT '0.5rem',
    custom_variables JSONB NOT NULL DEFAULT '{}'::jsonb,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_themes_web ON website_themes (website_id);

DROP TRIGGER IF EXISTS trg_website_themes_updated_at ON website_themes;
CREATE TRIGGER trg_website_themes_updated_at
BEFORE UPDATE ON website_themes
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- Table 3: website_modules
CREATE TABLE IF NOT EXISTS website_modules (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL,
    description TEXT,
    is_enabled BOOLEAN NOT NULL DEFAULT TRUE,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    settings JSONB NOT NULL DEFAULT '{}'::jsonb,
    CONSTRAINT uq_website_modules_web_slug UNIQUE (website_id, slug),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_modules_web ON website_modules (website_id);

DROP TRIGGER IF EXISTS trg_website_modules_updated_at ON website_modules;
CREATE TRIGGER trg_website_modules_updated_at
BEFORE UPDATE ON website_modules
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- Table 4: website_navigation
CREATE TABLE IF NOT EXISTS website_navigation (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    menu_location VARCHAR(50) NOT NULL DEFAULT 'header', -- header, footer, mobile
    title VARCHAR(100) NOT NULL,
    path VARCHAR(255) NOT NULL,
    target VARCHAR(20) NOT NULL DEFAULT '_self',
    parent_id INTEGER REFERENCES website_navigation(id) ON DELETE CASCADE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    icon VARCHAR(100),
    is_visible BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

