-- Table 337: website_transport_car_rentals
CREATE TABLE IF NOT EXISTS website_transport_car_rentals (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    vehicle_id INTEGER NOT NULL REFERENCES website_transport_vehicles(id) ON DELETE CASCADE,
    daily_rate NUMERIC(10,2) NOT NULL,
    hourly_rate NUMERIC(10,2),
    is_available BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_transport_car_rentals_web ON website_transport_car_rentals (website_id);

DROP TRIGGER IF EXISTS trg_website_transport_car_rentals_updated_at ON website_transport_car_rentals;
CREATE TRIGGER trg_website_transport_car_rentals_updated_at
BEFORE UPDATE ON website_transport_car_rentals
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- Table 338: website_transport_car_rental_plans
CREATE TABLE IF NOT EXISTS website_transport_car_rental_plans (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    car_rental_id INTEGER NOT NULL REFERENCES website_transport_car_rentals(id) ON DELETE CASCADE,
    plan_name VARCHAR(100) NOT NULL,
    included_km INTEGER NOT NULL DEFAULT 100,
    extra_km_rate NUMERIC(6,2) NOT NULL DEFAULT 1.00,
    price NUMERIC(10,2) NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_transport_car_rental_plans_web ON website_transport_car_rental_plans (website_id);

DROP TRIGGER IF EXISTS trg_website_transport_car_rental_plans_updated_at ON website_transport_car_rental_plans;
CREATE TRIGGER trg_website_transport_car_rental_plans_updated_at
BEFORE UPDATE ON website_transport_car_rental_plans
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- Table 339: website_transport_car_rental_bookings
CREATE TABLE IF NOT EXISTS website_transport_car_rental_bookings (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    car_rental_id INTEGER NOT NULL REFERENCES website_transport_car_rentals(id) ON DELETE RESTRICT,
    customer_id INTEGER REFERENCES website_customers(id) ON DELETE SET NULL,
    start_date TIMESTAMPTZ NOT NULL,
    end_date TIMESTAMPTZ NOT NULL,
    total_price NUMERIC(12,2) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'confirmed',
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_website_transport_car_rental_bookings_web ON website_transport_car_rental_bookings (website_id);

DROP TRIGGER IF EXISTS trg_website_transport_car_rental_bookings_updated_at ON website_transport_car_rental_bookings;
CREATE TRIGGER trg_website_transport_car_rental_bookings_updated_at
BEFORE UPDATE ON website_transport_car_rental_bookings
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

