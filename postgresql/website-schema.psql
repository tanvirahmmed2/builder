-- ============================================================================
-- Domain: Tenant Website System (website-schema.psql)
-- Platform: Multi-Website SaaS Portfolio & E-Commerce Builder
-- Database Engine: PostgreSQL 14+
-- Description: Tenant database schema for customer websites provisioned after package purchase.
--              Includes multi-tenancy (website_id FK to websites.id), Users, Multiple Roles,
--              Custom Roles, Modules, Custom Permissions per Module, Role Permissions,
--              Blogs, Blog Images, Products, Product Images, Support Tickets, Support Messages,
--              Support Images, Contact Inquiries, Purchase Orders, Purchase Payments, Offers,
--              Appointments, Experiences, Settings, Gallery, Categories, Services, Testimonials, Skills.
-- ============================================================================

-- 1. EXTENSIONS & FUNCTIONS
CREATE EXTENSION IF NOT EXISTS "pgcrypto";
CREATE EXTENSION IF NOT EXISTS "citext";

CREATE OR REPLACE FUNCTION trigger_set_timestamp()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

-- ============================================================================
-- 2. TENANT MODULES (Toggleable & configurable feature modules for the website)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_modules (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL, -- e.g. 'products', 'blogs', 'appointments', 'support', 'gallery', 'experiences', 'services', 'testimonials', 'contact'
    description TEXT,
    is_enabled BOOLEAN NOT NULL DEFAULT TRUE,
    settings JSONB NOT NULL DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_modules_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_modules_web ON tenant_modules (website_id);

DROP TRIGGER IF EXISTS trg_tenant_modules_updated_at ON tenant_modules;
CREATE TRIGGER trg_tenant_modules_updated_at
BEFORE UPDATE ON tenant_modules
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 3. TENANT ROLES (System roles + Customer-created custom roles)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_roles (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL, -- e.g. 'owner', 'admin', 'editor', 'store-manager', 'support-agent'
    description TEXT,
    is_system BOOLEAN NOT NULL DEFAULT FALSE, -- TRUE for default 'owner', 'admin'
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_roles_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_roles_web ON tenant_roles (website_id);

DROP TRIGGER IF EXISTS trg_tenant_roles_updated_at ON tenant_roles;
CREATE TRIGGER trg_tenant_roles_updated_at
BEFORE UPDATE ON tenant_roles
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 4. TENANT PERMISSIONS (Custom & standard permissions linked to modules)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_permissions (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    module_id INTEGER REFERENCES tenant_modules(id) ON DELETE CASCADE,
    name VARCHAR(150) NOT NULL,
    slug VARCHAR(150) NOT NULL, -- e.g. 'products.view', 'products.create', 'products.edit', 'products.delete', 'blogs.publish'
    action VARCHAR(50) NOT NULL DEFAULT 'manage', -- 'view', 'create', 'edit', 'delete', 'publish', 'manage'
    description TEXT,
    is_custom BOOLEAN NOT NULL DEFAULT FALSE, -- Customer can add custom permissions
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_permissions_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_permissions_web ON tenant_permissions (website_id);
CREATE INDEX IF NOT EXISTS idx_tenant_permissions_module ON tenant_permissions (module_id);

-- ============================================================================
-- 5. TENANT ROLE PERMISSIONS (Mapping roles to granted permissions)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_role_permissions (
    id SERIAL PRIMARY KEY,
    role_id INTEGER NOT NULL REFERENCES tenant_roles(id) ON DELETE CASCADE,
    permission_id INTEGER NOT NULL REFERENCES tenant_permissions(id) ON DELETE CASCADE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_role_permission UNIQUE (role_id, permission_id)
);

CREATE INDEX IF NOT EXISTS idx_tenant_role_perm_role ON tenant_role_permissions (role_id);
CREATE INDEX IF NOT EXISTS idx_tenant_role_perm_perm ON tenant_role_permissions (permission_id);

-- ============================================================================
-- 6. TENANT USERS (End customers, team members, staff on the tenant website)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_users (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email CITEXT NOT NULL,
    password VARCHAR(255) NOT NULL,
    phone VARCHAR(50),
    avatar_url TEXT,
    bio TEXT,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    email_verified BOOLEAN NOT NULL DEFAULT FALSE,
    last_login_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_users_web_email UNIQUE (website_id, email)
);

CREATE INDEX IF NOT EXISTS idx_tenant_users_web ON tenant_users (website_id);
CREATE INDEX IF NOT EXISTS idx_tenant_users_email ON tenant_users (website_id, email);

DROP TRIGGER IF EXISTS trg_tenant_users_updated_at ON tenant_users;
CREATE TRIGGER trg_tenant_users_updated_at
BEFORE UPDATE ON tenant_users
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 7. TENANT USER ROLES (Supporting multiple roles per user!)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_user_roles (
    id SERIAL PRIMARY KEY,
    user_id INTEGER NOT NULL REFERENCES tenant_users(id) ON DELETE CASCADE,
    role_id INTEGER NOT NULL REFERENCES tenant_roles(id) ON DELETE CASCADE,
    assigned_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_user_role UNIQUE (user_id, role_id)
);

CREATE INDEX IF NOT EXISTS idx_tenant_user_roles_user ON tenant_user_roles (user_id);
CREATE INDEX IF NOT EXISTS idx_tenant_user_roles_role ON tenant_user_roles (role_id);

-- ============================================================================
-- 8. TENANT SETTINGS (Theme branding, colors, typography, SEO, social links)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_settings (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE UNIQUE,
    site_title VARCHAR(255) NOT NULL DEFAULT 'My Portfolio & Store',
    tagline VARCHAR(255) DEFAULT 'Creator, Developer & Designer',
    bio TEXT,
    logo_url TEXT,
    favicon_url TEXT,
    primary_color VARCHAR(50) DEFAULT '#6366f1',
    secondary_color VARCHAR(50) DEFAULT '#10b981',
    font_family VARCHAR(100) DEFAULT 'Inter',
    contact_email CITEXT,
    contact_phone VARCHAR(50),
    address TEXT,
    currency VARCHAR(10) DEFAULT 'USD',
    currency_symbol VARCHAR(10) DEFAULT '$',
    social_links JSONB DEFAULT '{"github": "", "twitter": "", "linkedin": "", "instagram": "", "youtube": ""}'::jsonb,
    seo_config JSONB DEFAULT '{"meta_title": "", "meta_description": "", "keywords": []}'::jsonb,
    custom_domain_verified BOOLEAN DEFAULT FALSE,
    custom_css TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_settings_web ON tenant_settings (website_id);

DROP TRIGGER IF EXISTS trg_tenant_settings_updated_at ON tenant_settings;
CREATE TRIGGER trg_tenant_settings_updated_at
BEFORE UPDATE ON tenant_settings
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 9. TENANT CATEGORIES (For organizing Products and Blogs)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_categories (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    slug VARCHAR(100) NOT NULL,
    type VARCHAR(50) NOT NULL DEFAULT 'PRODUCT', -- 'PRODUCT', 'BLOG', 'GALLERY', 'SERVICE'
    description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_categories_web_slug UNIQUE (website_id, type, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_categories_web ON tenant_categories (website_id, type);

-- ============================================================================
-- 10. TENANT BLOGS & BLOG IMAGES
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_blogs (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    author_id INTEGER REFERENCES tenant_users(id) ON DELETE SET NULL,
    category_id INTEGER REFERENCES tenant_categories(id) ON DELETE SET NULL,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    excerpt TEXT,
    content TEXT NOT NULL,
    cover_image TEXT,
    tags TEXT[] DEFAULT '{}',
    is_published BOOLEAN NOT NULL DEFAULT TRUE,
    published_at TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    views_count INTEGER NOT NULL DEFAULT 0,
    seo_title VARCHAR(255),
    seo_description TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_blogs_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_blogs_web ON tenant_blogs (website_id, is_published);
CREATE INDEX IF NOT EXISTS idx_tenant_blogs_slug ON tenant_blogs (website_id, slug);

DROP TRIGGER IF EXISTS trg_tenant_blogs_updated_at ON tenant_blogs;
CREATE TRIGGER trg_tenant_blogs_updated_at
BEFORE UPDATE ON tenant_blogs
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

CREATE TABLE IF NOT EXISTS tenant_blog_images (
    id SERIAL PRIMARY KEY,
    blog_id INTEGER NOT NULL REFERENCES tenant_blogs(id) ON DELETE CASCADE,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    alt_text VARCHAR(255),
    caption TEXT,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_blog_images_blog ON tenant_blog_images (blog_id);

-- ============================================================================
-- 11. TENANT PRODUCTS & PRODUCT IMAGES (E-Commerce & Digital Goods)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_products (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    category_id INTEGER REFERENCES tenant_categories(id) ON DELETE SET NULL,
    name VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    short_description TEXT,
    price_in_cents INTEGER NOT NULL DEFAULT 0,
    compare_at_price_in_cents INTEGER,
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    sku VARCHAR(100),
    stock_quantity INTEGER NOT NULL DEFAULT 100,
    track_inventory BOOLEAN NOT NULL DEFAULT FALSE,
    is_digital BOOLEAN NOT NULL DEFAULT FALSE,
    download_url TEXT,
    status VARCHAR(50) NOT NULL DEFAULT 'ACTIVE' CHECK (status IN ('ACTIVE', 'DRAFT', 'ARCHIVED')),
    is_featured BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_products_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_products_web ON tenant_products (website_id, status);
CREATE INDEX IF NOT EXISTS idx_tenant_products_slug ON tenant_products (website_id, slug);

DROP TRIGGER IF EXISTS trg_tenant_products_updated_at ON tenant_products;
CREATE TRIGGER trg_tenant_products_updated_at
BEFORE UPDATE ON tenant_products
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

CREATE TABLE IF NOT EXISTS tenant_product_images (
    id SERIAL PRIMARY KEY,
    product_id INTEGER NOT NULL REFERENCES tenant_products(id) ON DELETE CASCADE,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    alt_text VARCHAR(255),
    is_primary BOOLEAN NOT NULL DEFAULT FALSE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_product_images_prod ON tenant_product_images (product_id);

-- ============================================================================
-- 12. TENANT SUPPORT, SUPPORT MESSAGES & SUPPORT IMAGES
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_support (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    ticket_number VARCHAR(100) NOT NULL,
    user_id INTEGER REFERENCES tenant_users(id) ON DELETE SET NULL,
    requester_name VARCHAR(255) NOT NULL,
    requester_email CITEXT NOT NULL,
    subject VARCHAR(255) NOT NULL,
    priority VARCHAR(50) NOT NULL DEFAULT 'MEDIUM' CHECK (priority IN ('LOW', 'MEDIUM', 'HIGH', 'URGENT')),
    status VARCHAR(50) NOT NULL DEFAULT 'OPEN' CHECK (status IN ('OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED')),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_support_web_ticket UNIQUE (website_id, ticket_number)
);

CREATE INDEX IF NOT EXISTS idx_tenant_support_web ON tenant_support (website_id, status);

DROP TRIGGER IF EXISTS trg_tenant_support_updated_at ON tenant_support;
CREATE TRIGGER trg_tenant_support_updated_at
BEFORE UPDATE ON tenant_support
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

CREATE TABLE IF NOT EXISTS tenant_support_messages (
    id SERIAL PRIMARY KEY,
    support_id INTEGER NOT NULL REFERENCES tenant_support(id) ON DELETE CASCADE,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    sender_type VARCHAR(20) NOT NULL DEFAULT 'CUSTOMER', -- 'CUSTOMER', 'ADMIN', 'AGENT'
    sender_id INTEGER,
    sender_name VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_support_messages_sup ON tenant_support_messages (support_id);

CREATE TABLE IF NOT EXISTS tenant_support_images (
    id SERIAL PRIMARY KEY,
    support_id INTEGER NOT NULL REFERENCES tenant_support(id) ON DELETE CASCADE,
    message_id INTEGER REFERENCES tenant_support_messages(id) ON DELETE SET NULL,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    image_url TEXT NOT NULL,
    file_name VARCHAR(255),
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_support_images_sup ON tenant_support_images (support_id);

-- ============================================================================
-- 13. TENANT CONTACT (Contact inquiries submitted from tenant website)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_contact (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(255) NOT NULL,
    email CITEXT NOT NULL,
    phone VARCHAR(50),
    subject VARCHAR(255) NOT NULL,
    message TEXT NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'NEW' CHECK (status IN ('NEW', 'READ', 'REPLIED', 'ARCHIVED')),
    reply TEXT,
    replied_at TIMESTAMPTZ,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_contact_web ON tenant_contact (website_id, status);

DROP TRIGGER IF EXISTS trg_tenant_contact_updated_at ON tenant_contact;
CREATE TRIGGER trg_tenant_contact_updated_at
BEFORE UPDATE ON tenant_contact
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 14. TENANT OFFERS (Coupons, discount promotions, banner sales)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_offers (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    code VARCHAR(50) NOT NULL,
    discount_type VARCHAR(20) NOT NULL DEFAULT 'PERCENTAGE' CHECK (discount_type IN ('PERCENTAGE', 'FIXED')),
    discount_value NUMERIC(10, 2) NOT NULL DEFAULT 10,
    min_order_amount_in_cents INTEGER DEFAULT 0,
    max_discount_amount_in_cents INTEGER,
    usage_limit INTEGER DEFAULT 100,
    usage_count INTEGER NOT NULL DEFAULT 0,
    valid_from TIMESTAMPTZ DEFAULT CURRENT_TIMESTAMP,
    valid_until TIMESTAMPTZ,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_offers_web_code UNIQUE (website_id, code)
);

CREATE INDEX IF NOT EXISTS idx_tenant_offers_web ON tenant_offers (website_id, is_active);

DROP TRIGGER IF EXISTS trg_tenant_offers_updated_at ON tenant_offers;
CREATE TRIGGER trg_tenant_offers_updated_at
BEFORE UPDATE ON tenant_offers
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 15. TENANT PURCHASE (Customer purchases & orders placed on website)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_purchase (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    order_number VARCHAR(100) NOT NULL,
    user_id INTEGER REFERENCES tenant_users(id) ON DELETE SET NULL,
    customer_name VARCHAR(255) NOT NULL,
    customer_email CITEXT NOT NULL,
    customer_phone VARCHAR(50),
    total_amount_in_cents INTEGER NOT NULL DEFAULT 0,
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    offer_code VARCHAR(50),
    discount_amount_in_cents INTEGER DEFAULT 0,
    status VARCHAR(50) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'PROCESSING', 'COMPLETED', 'CANCELLED', 'REFUNDED')),
    payment_status VARCHAR(50) NOT NULL DEFAULT 'PAID' CHECK (payment_status IN ('UNPAID', 'PAID', 'REFUNDED')),
    items JSONB NOT NULL DEFAULT '[]'::jsonb, -- Array of [{ product_id, name, price, quantity }]
    shipping_address JSONB DEFAULT '{}'::jsonb,
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_purchase_web_order UNIQUE (website_id, order_number)
);

CREATE INDEX IF NOT EXISTS idx_tenant_purchase_web ON tenant_purchase (website_id, status);

DROP TRIGGER IF EXISTS trg_tenant_purchase_updated_at ON tenant_purchase;
CREATE TRIGGER trg_tenant_purchase_updated_at
BEFORE UPDATE ON tenant_purchase
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 16. TENANT PURCHASE PAYMENTS (Transactions related to tenant orders)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_purchase_payments (
    id SERIAL PRIMARY KEY,
    purchase_id INTEGER NOT NULL REFERENCES tenant_purchase(id) ON DELETE CASCADE,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    amount_in_cents INTEGER NOT NULL DEFAULT 0,
    currency VARCHAR(10) NOT NULL DEFAULT 'USD',
    payment_method VARCHAR(50) NOT NULL DEFAULT 'CARD',
    transaction_id VARCHAR(255) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'SUCCESS',
    gateway_response JSONB DEFAULT '{}'::jsonb,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_payments_purchase ON tenant_purchase_payments (purchase_id);
CREATE INDEX IF NOT EXISTS idx_tenant_payments_web ON tenant_purchase_payments (website_id);

-- ============================================================================
-- 17. TENANT APPOINTMENTS (Booking schedule for services / consultations)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_appointments (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    user_id INTEGER REFERENCES tenant_users(id) ON DELETE SET NULL,
    client_name VARCHAR(255) NOT NULL,
    client_email CITEXT NOT NULL,
    client_phone VARCHAR(50),
    service_name VARCHAR(255) NOT NULL,
    appointment_date DATE NOT NULL,
    time_slot VARCHAR(50) NOT NULL,
    status VARCHAR(50) NOT NULL DEFAULT 'PENDING' CHECK (status IN ('PENDING', 'CONFIRMED', 'CANCELLED', 'COMPLETED')),
    notes TEXT,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_appointments_web ON tenant_appointments (website_id, status);
CREATE INDEX IF NOT EXISTS idx_tenant_appointments_date ON tenant_appointments (website_id, appointment_date);

DROP TRIGGER IF EXISTS trg_tenant_appointments_updated_at ON tenant_appointments;
CREATE TRIGGER trg_tenant_appointments_updated_at
BEFORE UPDATE ON tenant_appointments
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 18. TENANT EXPERIENCES (Portfolio timeline, roles, employment history)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_experiences (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    role_title VARCHAR(255) NOT NULL,
    organization VARCHAR(255) NOT NULL,
    organization_url TEXT,
    location VARCHAR(255),
    start_date DATE,
    end_date DATE,
    is_current BOOLEAN NOT NULL DEFAULT FALSE,
    description TEXT,
    skills_used TEXT[] DEFAULT '{}',
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_experiences_web ON tenant_experiences (website_id, sort_order ASC);

DROP TRIGGER IF EXISTS trg_tenant_experiences_updated_at ON tenant_experiences;
CREATE TRIGGER trg_tenant_experiences_updated_at
BEFORE UPDATE ON tenant_experiences
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 19. TENANT GALLERY (Portfolio media showcase)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_gallery (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    caption TEXT,
    category VARCHAR(100) DEFAULT 'Portfolio',
    image_url TEXT NOT NULL,
    thumbnail_url TEXT,
    media_type VARCHAR(20) NOT NULL DEFAULT 'IMAGE', -- 'IMAGE', 'VIDEO'
    sort_order INTEGER NOT NULL DEFAULT 0,
    is_featured BOOLEAN NOT NULL DEFAULT FALSE,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_gallery_web ON tenant_gallery (website_id, sort_order ASC);

DROP TRIGGER IF EXISTS trg_tenant_gallery_updated_at ON tenant_gallery;
CREATE TRIGGER trg_tenant_gallery_updated_at
BEFORE UPDATE ON tenant_gallery
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 20. TENANT SERVICES (Services provided by the creator/brand)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_services (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    title VARCHAR(255) NOT NULL,
    slug VARCHAR(255) NOT NULL,
    description TEXT,
    icon VARCHAR(100) DEFAULT 'BiCodeAlt',
    price_starting_at INTEGER DEFAULT 0,
    currency VARCHAR(10) DEFAULT 'USD',
    features JSONB DEFAULT '[]'::jsonb,
    is_active BOOLEAN NOT NULL DEFAULT TRUE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP,
    CONSTRAINT uq_tenant_services_web_slug UNIQUE (website_id, slug)
);

CREATE INDEX IF NOT EXISTS idx_tenant_services_web ON tenant_services (website_id, is_active);

DROP TRIGGER IF EXISTS trg_tenant_services_updated_at ON tenant_services;
CREATE TRIGGER trg_tenant_services_updated_at
BEFORE UPDATE ON tenant_services
FOR EACH ROW
EXECUTE FUNCTION trigger_set_timestamp();

-- ============================================================================
-- 21. TENANT TESTIMONIALS (Client reviews and endorsements)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_testimonials (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    client_name VARCHAR(255) NOT NULL,
    client_role VARCHAR(255),
    company VARCHAR(255),
    avatar_url TEXT,
    quote TEXT NOT NULL,
    rating INTEGER NOT NULL DEFAULT 5 CHECK (rating >= 1 AND rating <= 5),
    is_featured BOOLEAN NOT NULL DEFAULT TRUE,
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_testimonials_web ON tenant_testimonials (website_id, is_featured);

-- ============================================================================
-- 22. TENANT SKILLS (Technical/professional skills for portfolio)
-- ============================================================================
CREATE TABLE IF NOT EXISTS tenant_skills (
    id SERIAL PRIMARY KEY,
    website_id INTEGER NOT NULL REFERENCES websites(id) ON DELETE CASCADE,
    name VARCHAR(100) NOT NULL,
    category VARCHAR(100) DEFAULT 'Technical',
    proficiency INTEGER NOT NULL DEFAULT 90 CHECK (proficiency >= 0 AND proficiency <= 100),
    icon VARCHAR(100),
    sort_order INTEGER NOT NULL DEFAULT 0,
    created_at TIMESTAMPTZ NOT NULL DEFAULT CURRENT_TIMESTAMP
);

CREATE INDEX IF NOT EXISTS idx_tenant_skills_web ON tenant_skills (website_id, sort_order ASC);
